# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
ENABLE_TEST_ROUTES=false
AUTH_REQUIRED=true
JWT_SECRET=replace-with-at-least-32-random-characters-in-production
JWT_EXPIRES_IN=1h
JWT_ISSUER=awk-video-editor-api
JWT_AUDIENCE=awk-video-editor-client
BCRYPT_ROUNDS=12
MAX_PROJECTS_PER_USER=100
LOG_HASH_PEPPER=replace-with-random-log-hash-pepper

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=awk_video_editor

# Notes:
# - Replace MONGODB_URI if using MongoDB Atlas.
# - Do not commit a real .env file with credentials.

# Icon search translation/provider settings
# For best multilingual search, use Google Cloud Translation.
# If TRANSLATION_PROVIDER=none or GOOGLE_TRANSLATE_API_KEY is empty,
# icon search uses the local fallback dictionary.
TRANSLATION_PROVIDER=none
GOOGLE_TRANSLATE_API_KEY=

# Optional second icon provider. Required for provider=nounproject and
# /api/v1/icons/nounproject/:iconId/(download|file).
# The Noun Project API uses OAuth 1.0a with API key + API secret.
NOUN_PROJECT_API_KEY=
NOUN_PROJECT_API_SECRET=

# Optional chat route provider key. Tests set a local placeholder.
OPENAI_API_KEY=
