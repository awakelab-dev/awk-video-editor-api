# Server
PORT=4000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=awk_video_editor

# Notes:
# - Replace MONGODB_URI if using MongoDB Atlas.
# - Do not commit a real .env file with credentials.

# Icon search translation/provider settings
# For best multilingual search, use Google Cloud Translation.
TRANSLATION_PROVIDER=none
GOOGLE_TRANSLATE_API_KEY=

# Optional second icon provider. Required only for provider=nounproject.
NOUN_PROJECT_API_KEY=
NOUN_PROJECT_API_SECRET=
