# Server
PORT=4000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=awk_video_editor

# Auth
JWT_SECRET=dev-only-change-this-secret-please-123456789
JWT_EXPIRES_IN=1h
JWT_ISSUER=awk-video-editor-api
JWT_AUDIENCE=awk-video-editor-client
BCRYPT_ROUNDS=12
LOG_HASH_PEPPER=replace-with-long-random-log-hash-pepper
OPENAI_API_KEY=
PEXELS_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Notes:
# - Replace MONGODB_URI if using MongoDB Atlas.
# - Use a long, random JWT_SECRET in production.
# - Do not commit a real .env file with credentials.
